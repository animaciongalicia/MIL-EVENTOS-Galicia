# Variables de entorno de Mil Eventos Galicia.
# Copia estas claves en Vercel → Project → Settings → Environment Variables.
# Ninguna es obligatoria para que la web funcione; activan analítica/verificación.

# Google Analytics 4 — ID de medición del plugin del WordPress actual (formato G-XXXXXXXXXX).
# Lo encuentras en GA4 → Administrar → Flujos de datos → tu web → "ID de medición".
NEXT_PUBLIC_GA_ID=

# Google Search Console — token del método "Etiqueta HTML".
# En Search Console → Configuración → Propiedad → Verificación → "Etiqueta HTML":
# copia SOLO el valor del content="..." (no la etiqueta entera).
NEXT_PUBLIC_GSC_VERIFICATION=
